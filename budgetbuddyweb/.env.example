# BudgetBuddy Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:5206
VITE_ML_API_BASE_URL=http://localhost:8000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ML_FEATURES=true

# Default Region
VITE_DEFAULT_REGION=GB
VITE_SUPPORTED_REGIONS=GB,IN

# Environment
VITE_ENVIRONMENT=development
