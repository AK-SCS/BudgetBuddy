# BudgetBuddy Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_TYPE=sqlite
# For SQLite (Development)
SQLITE_CONNECTION_STRING=Data Source=Data/budgetbuddy.db
# For PostgreSQL (Production)
# POSTGRES_CONNECTION_STRING=Host=localhost;Database=budgetbuddy;Username=your_user;Password=your_password

# JWT Configuration
JWT_SECRET=your-secure-random-jwt-secret-key-minimum-32-characters-long
JWT_ISSUER=BudgetBuddyAPI
JWT_AUDIENCE=BudgetBuddyClient
JWT_EXPIRATION_MINUTES=60

# External Services
ML_SERVICE_BASE_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Logging
LOG_LEVEL=Information

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
