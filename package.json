{
  "name": "budgetbuddy",
  "scripts": {
    "prepare": "husky install",
    "format": "prettier --write \"budgetbuddyweb/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"budgetbuddyweb/src/**/*.{ts,tsx,json}\"",
    "lint:backend": "cd BudgetBuddy && dotnet format",
    "lint:ml": "cd BudgetBuddy-ml-service && flake8 . && black --check .",
    "lint:frontend": "cd budgetbuddyweb && npm run lint",
    "test:backend": "cd BudgetBuddy && dotnet test",
    "test:ml": "cd BudgetBuddy-ml-service && pytest",
    "test:frontend": "cd budgetbuddyweb && npm test",
    "test:all": "npm run test:backend && npm run test:ml && npm run test:frontend"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "prettier": "^3.3.3"
  }
}
